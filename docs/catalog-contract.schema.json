{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relay-wizard:sel-catalog-evidence:1",
  "title": "SEL read-only documentary catalog evidence contract v1",
  "$comment": "Legacy KB products may fail this readiness contract. Passing shape checks records evidence references only. No order-code generation, hardware suitability, manufacturer acceptance or procurement approval is granted. Source release SHA and canonical product hash are pinned outside this product. Semantic field ordering, token widths, reference exact-model matching and constraint references require adapter checks.",
  "$defs": {
    "reviewReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "string",
          "pattern": "^SEL-[0-9A-Z]+(-[0-9A-Z]+)*$"
        },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "source_sha256",
        "locator",
        "reviewer",
        "reviewed_on",
        "model",
        "revision"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalog_contract_version": {
      "const": 1
    },
    "model": {
      "type": "string",
      "pattern": "^SEL-[0-9A-Z]+(-[0-9A-Z]+)*$"
    },
    "prefix": {
      "type": "string",
      "pattern": "^[A-Z0-9]+$"
    },
    "prefix_note": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "doc_status": {
      "const": "manufacturer_reviewed"
    },
    "layout_verified": {
      "const": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "doc_date": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "doc_id",
        "url",
        "doc_date",
        "method"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "enum": [
              "stated",
              "manufacturer_verified"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]+$"
                },
                "desc": {
                  "type": "string",
                  "minLength": 1
                },
                "extra_cost": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "code",
                "desc",
                "extra_cost"
              ]
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "order",
          "width",
          "confidence",
          "options"
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "enum": [
                  "stated",
                  "manufacturer_verified"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "requires"
              },
              "if": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "in": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "field",
                      "in"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "not_in": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "field",
                      "not_in"
                    ]
                  }
                ]
              },
              "then": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "in": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "field",
                      "in"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "not_in": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "field",
                      "not_in"
                    ]
                  }
                ]
              }
            },
            "required": [
              "id",
              "type",
              "confidence",
              "if",
              "then"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "enum": [
                  "stated",
                  "manufacturer_verified"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "max_per_chassis"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "match_prefix": {
                "type": "string",
                "minLength": 1
              },
              "max": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "type",
              "confidence",
              "fields",
              "match_prefix",
              "max"
            ]
          }
        ]
      }
    },
    "accessories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "pn": {
            "type": [
              "string",
              "null"
            ]
          },
          "in_code": {
            "type": "boolean"
          },
          "extra_cost": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item",
          "pn",
          "in_code"
        ]
      }
    },
    "open_questions": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "firmware_compat": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": [
              "string",
              "null"
            ]
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "readiness_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_revision": {
          "$ref": "#/$defs/reviewReference"
        },
        "layout_review": {
          "$ref": "#/$defs/reviewReference"
        },
        "hardware_review": {
          "$ref": "#/$defs/reviewReference"
        },
        "application_review": {
          "$ref": "#/$defs/reviewReference"
        },
        "golden_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/reviewReference"
              },
              {
                "type": "object",
                "properties": {
                  "source_type": {
                    "enum": [
                      "manufacturer_configurator",
                      "manufacturer_quote",
                      "approved_as_built"
                    ]
                  }
                },
                "required": [
                  "source_type"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "source_revision",
        "layout_review",
        "hardware_review",
        "application_review",
        "golden_cases"
      ]
    }
  },
  "required": [
    "catalog_contract_version",
    "model",
    "prefix",
    "doc_status",
    "layout_verified",
    "source",
    "fields",
    "constraints",
    "accessories",
    "open_questions",
    "readiness_evidence"
  ]
}
